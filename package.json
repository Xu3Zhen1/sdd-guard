  "description": "把 YAGNI/KISS/DRY 与前后端解耦里可机械判定的部分变成会 FAIL 的规格驱动开发检查器（零依赖）",
  "license": "MIT",
  "author": "Xu3_Zhen1",
  "type": "module",
  "bin": {
    "sdd-guard": "cli.mjs"
  },
  "main": "cli.mjs",
  "files": [
    "cli.mjs",
    "lib/",
    "tools/",
    "templates/",
    "docs/",
    "AGENTS.md.template",
    "guard.config.json",
    "evidence.config.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
